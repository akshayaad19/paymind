# Copy to .env and fill in. .env is git-ignored.
# Never put a real key in this file: it is committed to git.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash gemini-3.5-flash gemini-3.5-flash-lite

# Empty -> local ./qdrant_data. Set both to use Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=

# Signs login tokens (JWT). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Observability (LangSmith). Get a key at https://smith.langchain.com → Settings → API Keys.
# Leave LANGSMITH_TRACING=false to turn tracing off.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=paymind
